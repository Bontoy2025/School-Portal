generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  students   Student[]
  teachers   Teacher[]
  parents    Parent[]
  classes    SchoolClass[]
  subjects   Subject[]
  enrollments Enrollment[]
  attendance Attendance[]
  timetables Timetable[]
  assignments Assignment[]
  submissions Submission[]
  grades     Grade[]
  announcements Announcement[]
  auditLogs  AuditLog[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role
  tenantId     String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  student     Student?
  teacher     Teacher?
  parent      Parent?
  auditLogs   AuditLog[]

  @@index([tenantId])
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

model Student {
  id             String      @id @default(cuid())
  userId         String      @unique
  admissionNumber String      @unique
  classId        String?
  guardianId     String?
  tenantId       String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  class       SchoolClass? @relation(fields: [classId], references: [id])
  guardian    Parent?      @relation(fields: [guardianId], references: [id])
  enrollments Enrollment[]
  attendance Attendance[]
  submissions Submission[]
  grades     Grade[]

  @@index([tenantId])
  @@index([tenantId, classId])
}

model Teacher {
  id           String   @id @default(cuid())
  userId       String   @unique
  employeeCode String   @unique
  department   String?
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id])
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  classes   SchoolClass[]
  subjects  Subject[]
  timetable Timetable[]
  assignments Assignment[]

  @@index([tenantId])
}

model Parent {
  id         String   @id @default(cuid())
  userId     String   @unique
  phone      String?
  relationship String?
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  children Student[]

  @@index([tenantId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  classes    SchoolClass[]
  enrollments Enrollment[]
}

model SchoolClass {
  id            String   @id @default(cuid())
  name          String
  gradeLevel    String
  academicYearId String
  teacherId     String?
  tenantId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  teacher      Teacher?      @relation(fields: [teacherId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  students     Student[]
  enrollments  Enrollment[]
  attendance   Attendance[]
  timetables   Timetable[]
  subjects     Subject[]

  @@index([tenantId, academicYearId])
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String
  classId   String?
  teacherId String?
  tenantId  String
  createdAt DateTime @default(now())

  class    SchoolClass? @relation(fields: [classId], references: [id])
  teacher  Teacher?     @relation(fields: [teacherId], references: [id])
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  timetable Timetable[]
  grades   Grade[]
  assignments Assignment[]

  @@index([tenantId])
}

model Enrollment {
  id             String   @id @default(cuid())
  studentId      String
  classId        String
  academicYearId String
  status         EnrollmentStatus @default(ACTIVE)
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student       @relation(fields: [studentId], references: [id])
  class        SchoolClass   @relation(fields: [classId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId, studentId, academicYearId])
  @@index([tenantId, classId, academicYearId])
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  date      DateTime
  period    String
  status    AttendanceStatus
  markedBy  String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student     @relation(fields: [studentId], references: [id])
  class   SchoolClass @relation(fields: [classId], references: [id])
  tenant  Tenant      @relation(fields: [tenantId], references: [id])

  @@index([tenantId, classId, date])
  @@unique([studentId, classId, date, period, tenantId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Timetable {
  id          String   @id @default(cuid())
  classId     String
  subjectId   String
  teacherId   String
  dayOfWeek   Int
  startTime   String
  endTime     String
  room        String?
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class   SchoolClass @relation(fields: [classId], references: [id])
  subject Subject     @relation(fields: [subjectId], references: [id])
  teacher Teacher     @relation(fields: [teacherId], references: [id])
  tenant  Tenant      @relation(fields: [tenantId], references: [id])

  @@index([tenantId, classId])
}

model Assignment {
  id          String   @id @default(cuid())
  subjectId   String
  title       String
  description String?
  dueDate     DateTime?
  maxScore    Int      @default(100)
  createdBy   String
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject    Subject      @relation(fields: [subjectId], references: [id])
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  submissions Submission[]

  @@index([tenantId, subjectId])
}

model Submission {
  id          String   @id @default(cuid())
  assignmentId String
  studentId    String
  fileUrl     String?
  submittedAt  DateTime @default(now())
  grade       Float?
  feedback     String?
  tenantId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])
  tenant     Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId, studentId])
}

model Grade {
  id             String   @id @default(cuid())
  studentId      String
  subjectId      String
  term           String
  assessmentType String
  score          Float
  maxScore       Float
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, studentId, term])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  audienceRole Role?
  classId     String?
  createdBy   String
  publishedAt DateTime @default(now())
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, publishedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  timestamp  DateTime @default(now())
  ipAddress  String?
  tenantId   String

  user  User?  @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, timestamp])
}
